  var ssTot=0, ssRes=0;
  for(var i2=0;i2<n;i2++){
    ssTot += (y[i2]-ym)*(y[i2]-ym);
    var pred = a + b*i2;
    ssRes += (y[i2]-pred)*(y[i2]-pred);
  }
  var r2 = ssTot===0 ? 1 : 1 - ssRes/ssTot;
  return {a:a, b:b, r2:r2};
}
function polyreg(y, degree){

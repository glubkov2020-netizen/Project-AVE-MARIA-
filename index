    goTo("data");
  } else {
    setTimeout(function(){ showConsent(); refreshAll(); goTo("data"); }, 2400);
  }

  tInfo("Платформа запущена · v5.0");
  setTimeout(function(){
    if(!localStorage.getItem("energy_onb") && consentLoaded){
      $("onb").classList.add("open");
      $("onbBackdrop").classList.add("open");
    }
  }, 3200);
}
if(document.readyState === "loading"){ document.addEventListener("DOMContentLoaded", start); }
else { start(); }
</script>


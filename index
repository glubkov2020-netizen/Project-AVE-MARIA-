/* ============================================================
   SPLASH CANVAS
============================================================ */
function setupSplashCanvas(){
  var canvas = $("splash-canvas");
  if(!canvas) return;
  var ctx = canvas.getContext("2d");
  var particles = [];
  var W = canvas.width = window.innerWidth;
  var H = canvas.height = window.innerHeight;
  function resize(){ W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
  window.addEventListener("resize", resize);
  for(var i=0;i<70;i++){
    particles.push({
      x: Math.random()*W,
      y: Math.random()*H,
      vx: (Math.random()-0.5)*0.3,
      vy: (Math.random()-0.5)*0.3,
      r: Math.random()*1.8+0.4
    });
  }
  var pct = 0;
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(var i=0;i<particles.length;i++){
      var p = particles[i];
      p.x += p.vx; p.y += p.vy;
      if(p.x < 0 || p.x > W) p.vx *= -1;
      if(p.y < 0 || p.y > H) p.vy *= -1;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
      ctx.fillStyle = "rgba(255,255,255," + (0.3 + Math.random()*0.3) + ")";
      ctx.fill();
    }
    // Соединяющие линии
    for(var a=0;a<particles.length;a++){
      for(var b=a+1;b<particles.length;b++){
        var dx = particles[a].x - particles[b].x;
        var dy = particles[a].y - particles[b].y;
        var d = Math.sqrt(dx*dx + dy*dy);
        if(d < 100){
          ctx.beginPath();
          ctx.strokeStyle = "rgba(100,150,255," + (0.15 * (1-d/100)) + ")";
          ctx.lineWidth = 0.5;
          ctx.moveTo(particles[a].x, particles[a].y);
          ctx.lineTo(particles[b].x, particles[b].y);
          ctx.stroke();
        }
      }
    }
    requestAnimationFrame(draw);
  }
  draw();
  // Прогресс
  var pctEl = $("splashPct");
  var start = Date.now();
  var dur = 2000;
  function updPct(){
    var el = Date.now() - start;
    pct = Math.min(100, Math.round(el/dur*100));
    if(pctEl) pctEl.textContent = pct + "%";
    if(pct < 100) requestAnimationFrame(updPct);
  }
  requestAnimationFrame(updPct);
}
function hideSplash(){
  var s = $("splash");
  if(!s) return;
  s.classList.add("hide");
  setTimeout(function(){ if(s) s.remove(); }, 700);
}


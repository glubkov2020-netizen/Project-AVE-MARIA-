    if(!years.length){ tbody2.innerHTML = '<tr><td colspan="6" class="empty">Нет данных.</td></tr>'; }
    else {
      var tot = totalsByYearSelected();
      var baseV = tot[years[0]]!=null?tot[years[0]]:null;
      var totalsArr = years.map(function(y){ return tot[y]||0; });
      var ma = movingAvg(totalsArr, 3);
      var prev = null;
      tbody2.innerHTML = years.map(function(y,i){
        var v = tot[y]!=null?tot[y]:null;
        var abs = (v!=null && prev!=null) ? v-prev : null;
        var chain = (v!=null && prev!=null && prev>0) ? (v/prev-1)*100 : null;
        var baseT = (v!=null && baseV!=null && baseV>0) ? (v/baseV*100) : null;
        var html = '<tr><td>'+y+'</td>'+
          '<td class="num">'+(v!=null?fmtNum(convertUnits(v),1):"—")+'</td>'+
          '<td class="num '+(abs>0?'pos':abs<0?'neg':'')+'">'+(abs!=null?fmtNum(convertUnits(abs),2):"—")+'</td>'+
          '<td class="num">'+(chain!=null?fmtNum(chain,2):"—")+'</td>'+
          '<td class="num">'+(baseT!=null?fmtNum(baseT,2):"—")+'</td>'+
          '<td class="num">'+fmtNum(ma[i],2)+'</td></tr>';
        prev = v; return html;
      }).join("");
    }
  }
  var sel = $("detailRegion");
  if(sel){
    var pv = sel.value;
    sel.innerHTML = rows.map(function(r){ return '<option>'+escapeHtml(r.region)+'</option>'; }).join("");

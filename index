    border:none; box-shadow:var(--shadow-lg); font-size:18px; cursor:pointer;
    display:flex; align-items:center; justify-content:center; transition:transform .2s;
    -webkit-tap-highlight-color:transparent;
  }
  .term-toggle:hover{transform:scale(1.05); background:var(--accent-hover)}
  .terminal{
    position:fixed; left:0; right:0; bottom:0; height:52dvh;
    background:var(--term-bg); color:var(--term-fg);
    font-family:var(--font-mono); font-size:12px;
    transform:translateY(100%); transition:transform .25s ease; z-index:950;
    display:flex; flex-direction:column; box-shadow:0 -8px 30px rgba(0,0,0,.4);
    border-top:2px solid var(--accent);
  }
  .terminal.open{transform:none}
  .term-tabs{display:flex; gap:1px; padding:6px 8px 0; border-bottom:1px solid #1c263a; flex-wrap:wrap; align-items:center; background:#08111c}
  .term-tabs button{
    background:transparent; border:none; color:#8fa2c4; padding:7px 12px; font-size:11.5px;
    border-radius:5px 5px 0 0; cursor:pointer; font-weight:500;
  }
  .term-tabs button:hover{background:#131c30; color:#fff}
  .term-tabs button.active{background:#0f1730; color:#7fb1ff; border-bottom:2px solid var(--accent)}
  .term-tabs .spacer{flex:1}
  .term-tabs .close{background:#7b1a1a; color:#fff; padding:5px 10px; font-size:13px; border-radius:4px}
  .term-body{flex:1; overflow:auto; padding:10px 14px; line-height:1.6; -webkit-overflow-scrolling:touch}
  .term-body .line{white-space:pre-wrap; word-break:break-word; margin-bottom:2px}
  .term-body .t-info{color:#7fb1ff}
  .term-body .t-ok{color:#4ade80}
  .term-body .t-warn{color:#fbbf24}
  .term-body .t-err{color:#f87171}
  .term-body .t-muted{color:#6b7a94}
  .term-body .t-cmd{color:#c084fc}
  .term-quick{display:flex; gap:5px; padding:7px 12px; border-top:1px solid #1c263a; background:#050810; overflow-x:auto; flex-wrap:nowrap; -webkit-overflow-scrolling:touch; scrollbar-width:none}
  .term-quick::-webkit-scrollbar{display:none}
  .term-quick button{
    background:#131c30; color:#7fb1ff; border:1px solid #24314a;
    padding:4px 9px; font-size:10.5px; border-radius:5px; cursor:pointer; white-space:nowrap;
    min-height:auto; font-family:var(--font-mono); flex-shrink:0;
  }
  .term-quick button:hover{background:#1a2942; border-color:var(--accent)}
  .term-input{
    display:flex; gap:6px; padding:8px 12px calc(8px + env(safe-area-inset-bottom)); border-top:1px solid #1c263a; background:#050810;
  }
  .term-input input{
    flex:1; background:#0b1220; color:#e6edf7; border:1px solid #24314a;
    padding:9px 11px; border-radius:5px; font-family:inherit; font-size:12.5px;
  }
  .term-input input:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 2px rgba(91,141,239,.2)}
  .term-input .prompt{color:#4ade80; padding:9px 4px; user-select:none; font-weight:600}
  .term-tab-panel{display:none}
  .term-tab-panel.active{display:block}

  /* Commands catalog */
  .cmd-grid{display:flex; flex-direction:column; gap:6px}
  .cmd-item{
    background:#0f1730; border:1px solid #1c263a; border-radius:6px;
    padding:10px 12px; cursor:pointer; transition:.15s;
  }
  .cmd-item:hover{background:#152040; border-color:#2a3d5c}
  .cmd-item .cmd-name{color:#7fb1ff; font-weight:600; font-size:12.5px; font-family:var(--font-mono); margin-bottom:3px}
  .cmd-item .cmd-desc{color:#94a3b8; font-size:11.5px; line-height:1.5}
  .cmd-item .cmd-usage{color:#c084fc; font-size:11px; font-family:var(--font-mono); margin-top:4px}
  .cmd-cat{color:#4ade80; font-size:10px; text-transform:uppercase; letter-spacing:.08em; margin:14px 0 6px; font-weight:600}

  /* ============ PALETTE ============ */
  .palette-backdrop{position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:960; display:none; animation:fadeIn .15s}
  .palette-backdrop.open{display:block}
  .palette{
    position:fixed; top:80px; left:50%; transform:translateX(-50%);
    width:min(580px, calc(100vw - 32px)); background:var(--panel);
    border:1px solid var(--border); border-radius:var(--radius-lg); box-shadow:var(--shadow-lg);
    z-index:961; display:none; overflow:hidden;
  }
  .palette.open{display:block; animation:fadeSlide .2s ease}
  .palette input{
    width:100%; border:none; border-bottom:1px solid var(--border);
    padding:14px 16px; font-size:14px; font-family:var(--font-ui);
    background:var(--panel); color:var(--text); outline:none; border-radius:0;
  }
  .palette .results{max-height:400px; overflow:auto; -webkit-overflow-scrolling:touch}
  .palette .item{
    padding:10px 16px; cursor:pointer; font-size:12.5px;
    border-bottom:1px solid var(--border-soft); display:flex; justify-content:space-between; gap:10px;
    color:var(--text-soft);
  }
  .palette .item:hover, .palette .item.selected{background:var(--accent-soft); color:var(--accent)}
  .palette .item .cat{font-size:10.5px; color:var(--muted)}

  .health-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px; margin-bottom:12px}
  .health-item{padding:12px; border-radius:var(--radius); border:1px solid var(--border); font-size:12px}
  .health-item.ok{border-color:var(--ok); background:var(--ok-soft)}
  .health-item.warn{border-color:var(--warn); background:var(--warn-soft)}
  .health-item.err{border-color:var(--err); background:var(--err-soft)}
  .health-item b{display:block; font-size:19px; margin-bottom:3px; font-weight:700}
  .matrix-cell{display:inline-block; width:14px; height:14px; border-radius:3px; margin:1px; cursor:pointer}
  .matrix-cell.has{background:var(--accent)}
  .matrix-cell.no{background:var(--border)}

  /* ============ ONBOARDING ============ */
  .onb-backdrop{position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:970; display:none}
  .onb-backdrop.open{display:block; animation:fadeIn .25s}
  .onb{
    position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
    width:min(560px, calc(100vw - 32px)); max-height:90dvh; overflow-y:auto;
    background:var(--panel); color:var(--text);
    border-radius:var(--radius-lg); padding:26px 28px; box-shadow:var(--shadow-lg);
    z-index:971; display:none; animation:fadeSlide .3s ease;
  }
  .onb.open{display:block}
  .onb h2{margin:0 0 12px; font-size:19px}
  .onb p{font-size:13.5px; line-height:1.6; color:var(--text-soft)}
  .onb ul{font-size:12.5px; line-height:1.7; padding-left:18px; color:var(--text-soft)}
  .onb .actions{display:flex; justify-content:flex-end; gap:8px; margin-top:18px; flex-wrap:wrap}

  /* ============ CONSENT ============ */
  .consent{
    position:fixed; left:16px; right:16px; bottom:70px; z-index:980;
    background:var(--panel); border:1px solid var(--border); border-radius:var(--radius-lg);
    box-shadow:var(--shadow-lg); padding:16px 18px;
    display:none; animation:fadeSlide .3s ease;
    max-width:520px;
  }
  .consent.open{display:block}
  .consent h3{font-size:13.5px; margin-bottom:6px; display:flex; align-items:center; gap:6px}
  .consent p{font-size:12px; color:var(--text-soft); line-height:1.5; margin-bottom:10px}
  .consent .actions{display:flex; gap:6px; flex-wrap:wrap}
  .consent .actions button{font-size:11.5px; padding:7px 13px}

  /* Docs */
  .doc-hero{
    background:linear-gradient(135deg, var(--accent) 0%, var(--accent-3) 100%);
    color:#fff; padding:30px 32px; border-radius:var(--radius-lg); margin-bottom:20px;
    box-shadow:var(--shadow); position:relative; overflow:hidden;
  }
  .doc-hero::before{
    content:""; position:absolute; right:-40px; top:-40px; width:160px; height:160px;
    background:radial-gradient(circle, rgba(255,255,255,.2), transparent 70%);
    border-radius:50%;
  }
  .doc-hero h1{font-size:24px; margin:0 0 8px; position:relative}
  .doc-hero p{font-size:13.5px; opacity:.95; max-width:700px; margin:0; line-height:1.6; position:relative}
  .doc-nav{
    display:flex; gap:4px; flex-wrap:wrap; padding:8px; background:var(--panel);
    border:1px solid var(--border); border-radius:var(--radius); margin-bottom:16px;
    position:sticky; top:12px; z-index:10; box-shadow:var(--shadow-xs);
  }
  .doc-nav a{
    padding:6px 11px; border-radius:var(--radius-sm); font-size:12px; color:var(--text-soft);
    transition:.15s; text-decoration:none; white-space:nowrap;
  }
  .doc-nav a:hover{background:var(--accent-soft); color:var(--accent); text-decoration:none}
  .doc-section{margin-bottom:28px; scroll-margin-top:70px}
  .doc-section h2{font-size:19px; margin-bottom:12px; padding-bottom:8px; border-bottom:2px solid var(--border-soft)}
  .doc-section h3{font-size:14.5px; margin:18px 0 8px; color:var(--text)}
  .doc-section h4{font-size:13px; margin:14px 0 6px; color:var(--text-soft); font-weight:600}
  .doc-section p{font-size:13.5px; line-height:1.7; color:var(--text-soft); margin:8px 0}
  .doc-section ul, .doc-section ol{font-size:13.5px; line-height:1.7; color:var(--text-soft); margin:8px 0; padding-left:22px}
  .doc-section li{margin:4px 0}

  .formula{
    background:var(--code-bg); color:var(--code-fg); padding:14px 18px; border-radius:var(--radius);
    font-family:var(--font-mono); font-size:12.5px; margin:10px 0; line-height:1.7;
    border-left:3px solid var(--accent); overflow-x:auto;
  }
  .formula .label{color:#7fb1ff; font-weight:600; display:block; margin-bottom:6px; font-size:11px; text-transform:uppercase; letter-spacing:.05em}

  .callout{
    padding:12px 16px; border-radius:var(--radius); border-left:3px solid var(--accent);
    background:var(--accent-soft-2); margin:12px 0; font-size:13px; color:var(--text-soft); line-height:1.6;
  }
  .callout.ok{border-left-color:var(--ok); background:var(--ok-soft)}
  .callout.warn{border-left-color:var(--warn); background:var(--warn-soft)}
  .callout.danger{border-left-color:var(--err); background:var(--err-soft)}
  .callout strong{color:var(--text)}

  .link-list{display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:10px; margin:12px 0}
  .link-card{
    padding:14px 16px; border:1px solid var(--border); border-radius:var(--radius); background:var(--panel);
    transition:.15s; text-decoration:none; color:var(--text); display:block;
  }
  .link-card:hover{border-color:var(--accent); box-shadow:var(--shadow-sm); text-decoration:none}
  .link-card .title{font-weight:600; font-size:13px; margin-bottom:3px; color:var(--accent)}
  .link-card .desc{font-size:11.5px; color:var(--muted); line-height:1.5}
  .link-card .url{font-size:10.5px; color:var(--muted); font-family:var(--font-mono); margin-top:4px; word-break:break-all}

  .stat-box{background:var(--panel-alt); border:1px solid var(--border); border-radius:var(--radius); padding:12px 14px; margin:8px 0}
  .stat-box .label{font-size:10.5px; text-transform:uppercase; color:var(--muted); letter-spacing:.05em; font-weight:600; margin-bottom:3px}
  .stat-box .value{font-size:17px; font-weight:700; color:var(--text)}

  .faq-item{border-bottom:1px solid var(--border-soft); padding:12px 0}
  .faq-item:last-child{border-bottom:none}
  .faq-item .q{font-weight:600; font-size:13.5px; margin-bottom:5px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; color:var(--text)}
  .faq-item .q:hover{color:var(--accent)}
  .faq-item .q .arrow{transition:.2s; color:var(--muted)}
  .faq-item.open .q .arrow{transform:rotate(180deg)}
  .faq-item .a{font-size:13px; color:var(--text-soft); line-height:1.7; max-height:0; overflow:hidden; transition:.3s; padding-left:2px}
  .faq-item.open .a{max-height:800px; padding-top:6px}

  @media print{
    .side, .mobile-nav, .page-head, .kpis, #toasts, #tooltip, #banner, .term-toggle, .terminal, .palette, .palette-backdrop, .onb, .onb-backdrop, .doc-nav, .consent, #splash, .drawer-backdrop, .drawer{display:none !important}
    main{padding:0; max-width:none}
    .card{border:none; box-shadow:none; padding:0; margin:0 0 12px 0}
    .page{display:block !important}
  }
</style>
</head>

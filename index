function pickBestModel(y){
  var lr = linreg(y), poly = polyreg(y, 2), exp = expreg(y);
  var models = [];
  if(lr){ var fL = y.map(function(_,i){ return lr.a+lr.b*i; }); models.push({name:"Линейный", r2:lr.r2, mape:mape(y,fL), a:lr.a, b:lr.b, predict:function(t){ return lr.a+lr.b*t; }}); }
  if(poly){ var fP = y.map(function(_,i){ return poly.predict(i); }); models.push({name:"Полином-2", r2:poly.r2, mape:mape(y,fP), a:poly.coef[0], b:poly.coef[1], predict:poly.predict}); }
  if(exp){ var fE = y.map(function(_,i){ return exp.predict(i); }); models.push({name:"Экспонента", r2:exp.r2, mape:mape(y,fE), a:exp.a, b:exp.b, predict:exp.predict}); }
  if(!models.length) return null;
  models.sort(function(a,b){ return (b.r2||0)-(a.r2||0); });
  return models[0];
}
function renderTrend(){
  var rows = buildStats().filter(function(r){return r.slope!=null;});
  var tbody = document.querySelector("#trendTable tbody");
  var div = $("trendChart");
  if(!rows.length){ if(tbody) tbody.innerHTML = '<tr><td colspan="10" class="empty">Недостаточно данных.</td></tr>'; if(div && plotlyReady()) Plotly.newPlot(div, [], baseLayout({title:{text:"Нет данных"}}), PLOT_CFG); return; }
  var horizon = Number($("forecastYears").value)||3;
  if(div && plotlyReady()){
    var traces = [];
    rows.forEach(function(r,i){
      var s = seriesFor(r.region);
      var color = PALETTE[i%PALETTE.length];
      traces.push({name:r.region, x:s.years, y:s.values.map(convertUnits), type:"scatter", mode:"lines+markers",
        line:{color:color,width:2}, marker:{color:color,size:4}, legendgroup:r.region});
      var lr = linreg(s.values);
      if(lr){
        var lastYear = s.years[s.years.length-1];
        var fitX=[], fitY=[];
        for(var k=0;k<s.values.length;k++){ fitX.push(s.years[k]); fitY.push(lr.a+lr.b*k); }
        for(var k2=1;k2<=horizon;k2++){ fitX.push(lastYear+k2); fitY.push(lr.a+lr.b*(s.values.length-1+k2)); }
        traces.push({name:r.region+" тренд", x:fitX, y:fitY.map(convertUnits), type:"scatter", mode:"lines",
          line:{color:color,width:1.2,dash:"dot"}, showlegend:false, hoverinfo:"skip"});
      }
    });
    Plotly.newPlot(div, traces, baseLayout({}), PLOT_CFG);
  }
  if(tbody){
    tbody.innerHTML = rows.map(function(r){
      var s = seriesFor(r.region);
      var best = pickBestModel(s.values); if(!best) return '';
      var pred = function(k){ return best.predict(s.values.length-1+k); };
      return '<tr><td>'+escapeHtml(r.region)+'</td><td>'+best.name+'</td>'+
        '<td class="num">'+fmtNum(best.r2,3)+'</td>'+
        '<td class="num">'+(best.mape!=null?fmtNum(best.mape,2):"—")+'</td>'+
        '<td class="num">'+fmtNum(best.a,3)+'</td>'+
        '<td class="num">'+fmtNum(best.b,4)+'</td>'+
        '<td class="num">'+fmtNum(convertUnits(pred(1)),2)+'</td>'+
        '<td class="num">'+fmtNum(convertUnits(pred(2)),2)+'</td>'+
        '<td class="num">'+fmtNum(convertUnits(pred(3)),2)+'</td>'+
        '<td class="num">'+fmtNum(convertUnits(pred(5)),2)+'</td></tr>';
    }).join("");
  }
}

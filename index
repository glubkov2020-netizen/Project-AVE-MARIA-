function buildStats(){
  var rows = [];
  REGIONS.forEach(function(reg){
    if(!state.selected[reg]) return;
    var s = seriesFor(reg); if(!s.values.length) return;
    var totalAll = totalsByYearAll(), ownTotal = 0, allTotal = 0;
    for(var i=0;i<s.years.length;i++){ var ta = totalAll[s.years[i]]; if(ta){ ownTotal += s.values[i]; allTotal += ta; } }
    var m = mean(s.values), sd = std(s.values), lr = linreg(s.values);
    var ups = 0, totPairs = 0;
    for(var j=1;j<s.values.length;j++) if(s.values[j-1]>0){ totPairs++; if(s.values[j]>s.values[j-1]) ups++; }
    rows.push({
      region: reg, n: s.values.length, sum: sum(s.values),
      mean: m, median: median(s.values), std: sd,
      cv: (sd!=null && m>0) ? sd/m*100 : null,
      min: minOf(s.values), max: maxOf(s.values),
      cagr: cagrFromSeries(s.years, s.values),
      slope: lr ? lr.b : null, r2: lr ? lr.r2 : null,
      share: allTotal>0 ? ownTotal/allTotal*100 : null,
      upShare: totPairs>0 ? ups/totPairs*100 : null
    });
  });
  return rows;
}
function renderStats(){
  var rows = buildStats();

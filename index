  .page{display:none}
  .page.active{display:block; animation:fadeSlide .3s ease both}
  .divider{height:1px; background:var(--border-soft); margin:12px 0}
  .empty{padding:22px; text-align:center; color:var(--muted); font-size:12.5px}

  #banner{display:none; background:var(--err-soft); border:1px solid var(--err); color:var(--err);
    padding:10px 14px; border-radius:var(--radius-sm); margin-bottom:12px; font-size:12px}
  #banner.show{display:block}
  #banner code{background:rgba(0,0,0,.08); padding:1px 5px; border-radius:4px}

  #toasts{position:fixed; right:14px; bottom:70px; z-index:9999; display:flex; flex-direction:column; gap:6px; pointer-events:none}
  .toast{
    background:var(--panel); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm);
    padding:9px 13px; box-shadow:var(--shadow-lg);
    font-size:12px; max-width:340px;
    transform:translateY(10px); opacity:0; transition:.25s; pointer-events:auto; border-left:3px solid var(--accent);
  }
  .toast.show{transform:none; opacity:1}
  .toast.ok{border-left-color:var(--ok)}
  .toast.err{border-left-color:var(--err)}
  .toast.warn{border-left-color:var(--warn)}

  #tooltip{
    position:fixed; z-index:9998; background:var(--text); color:var(--panel);
    border-radius:var(--radius-sm); padding:5px 9px;
    font-size:11px; max-width:280px; line-height:1.4;
    box-shadow:var(--shadow-lg); display:none; pointer-events:none;
  }

  #exportStage{position:fixed; left:-99999px; top:0; width:1200px; height:700px; background:#fff; z-index:-1}

  /* ============ TERMINAL ============ */
  .term-toggle{
    position:fixed; right:14px; bottom:14px; z-index:850;

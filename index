function renderDetail(){
  var reg = $("detailRegion")?$("detailRegion").value:"";
  var tbody = document.querySelector("#detailTable tbody"); if(!tbody) return;
  if(!reg){ tbody.innerHTML = '<tr><td colspan="7" class="empty">Выберите регион.</td></tr>'; return; }
  var s = seriesFor(reg);
  if(!s.values.length){ tbody.innerHTML = '<tr><td colspan="7" class="empty">Нет данных.</td></tr>'; return; }
  var m = mean(s.values), sd = std(s.values), baseV = s.values[0];
  var prev = null;
  tbody.innerHTML = s.years.map(function(y,i){
    var v = s.values[i];
    var abs = prev!=null ? v-prev : null;
    var chain = (prev!=null && prev>0) ? (v/prev-1)*100 : null;
    var base = (baseV>0) ? (v/baseV*100) : null;
    var z = (sd!=null && sd>0) ? ((v-m)/sd) : null;
    var flag = z==null ? "" : (Math.abs(z)>3 ? "сильный" : (Math.abs(z)>2 ? "выброс" : ""));
    var html = '<tr><td>'+y+'</td>'+
      '<td class="num">'+fmtNum(convertUnits(v),2)+'</td>'+
      '<td class="num '+(abs>0?'pos':abs<0?'neg':'')+'">'+(abs!=null?fmtNum(convertUnits(abs),2):"—")+'</td>'+
      '<td class="num">'+(chain!=null?fmtNum(chain,2):"—")+'</td>'+
      '<td class="num">'+(base!=null?fmtNum(base,2):"—")+'</td>'+
      '<td class="num '+(flag?'warn':'')+'">'+(z!=null?fmtNum(z,2):"—")+'</td>'+
      '<td>'+flag+'</td></tr>';
    prev = v; return html;
  }).join("");
}


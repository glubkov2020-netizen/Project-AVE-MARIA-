function xlsxReady(){ return typeof window.XLSX !== "undefined"; }
function html2canvasReady(){ return typeof window.html2canvas !== "undefined"; }
function docxReady(){ return typeof window.docx !== "undefined"; }
function jszipReady(){ return typeof window.JSZip !== "undefined"; }

var REGIONS = [
  "Кемеровская обл.","Москва","Новосибирская обл.","Красноярский край","Санкт-Петербург",
  "Свердловская обл.","Тюменская обл.","Иркутская обл.","Ханты-Мансийский АО — Югра","Ямало-Ненецкий АО"
];
var STATUSES = ["факт","оценка","прогноз"];
var PALETTE = ["#1e40af","#0891b2","#7c3aed","#d97706","#dc2626","#059669","#a16207","#0f766e","#9333ea","#b91c1c","#0891b2","#7c3aed"];
var COOKIE_CONSENT_KEY = "energy_cookie_consent_v5";

var state = {
  data: [], selected: {}, theme: "light", expMode: "short",
  optUnit: "bln", optPrec: 2, optSep: "ru",
  consent: null
};

/* ============================================================
   ЛОГИ
============================================================ */
var LOG = { info: [], err: [], warn: [] };
function tlog(level, msg){
  var e = { t: new Date(), level: level, msg: msg };
  if(level==="ERR") LOG.err.push(e);
  else if(level==="WARN") LOG.warn.push(e);
  LOG.info.push(e);
  renderTerm();
}
function tErr(m){ tlog("ERR",m); console.error(m); }
function tWarn(m){ tlog("WARN",m); console.warn(m); }
function tInfo(m){ tlog("INFO",m); }
function renderTerm(){
  if(!$("panelLog")) return;
  var fmt = function(e){
    var hm = String(e.t.getHours()).padStart(2,"0")+":"+String(e.t.getMinutes()).padStart(2,"0")+":"+String(e.t.getSeconds()).padStart(2,"0");
    var cls = e.level==="ERR"?"t-err":e.level==="WARN"?"t-warn":"t-info";
    return '<div class="line"><span class="t-muted">['+hm+']</span> <span class="'+cls+'">'+e.level+'</span> '+escapeHtml(e.msg)+'</div>';
  };
  $("panelLog").innerHTML = LOG.info.slice(-500).map(fmt).join("") || '<div class="t-muted">— пусто —</div>';
  $("panelErr").innerHTML = LOG.err.slice(-200).map(fmt).join("") || '<div class="t-muted">— пусто —</div>';
  $("panelWarn").innerHTML = LOG.warn.slice(-200).map(fmt).join("") || '<div class="t-muted">— пусто —</div>';
  renderDataPanel();
}
function renderDataPanel(){
  if(!$("panelData")) return;
  var years = yearsAll();
  $("panelData").innerHTML =
    '<div class="t-muted">state.data: '+state.data.length+' строк</div>'+
    '<div class="t-muted">selected: '+Object.keys(state.selected).filter(function(k){return state.selected[k];}).length+' регионов</div>'+
    '<div class="t-muted">годы: '+(years.length?years[0]+"–"+years[years.length-1]:"—")+'</div>'+
    '<div class="t-muted">theme: '+state.theme+' · unit: '+state.optUnit+' · prec: '+state.optPrec+'</div>'+
    '<div class="t-muted">consent: '+(state.consent||"—")+'</div>';
}

/* ============================================================
   ТОСТЫ / ТУЛТИПЫ
============================================================ */
function toast(text, kind){
  var t = document.createElement("div");
  t.className = "toast " + (kind||"ok");
  t.textContent = text;
  $("toasts").appendChild(t);
  setTimeout(function(){ t.classList.add("show"); }, 10);
  setTimeout(function(){ t.classList.remove("show"); setTimeout(function(){ t.remove(); }, 300); }, 3500);
}
var _tipTarget = null;
function setupTooltips(){
  var tip = $("tooltip");
  document.body.addEventListener("mouseover", function(e){
    var el = e.target.closest && e.target.closest("[data-tip]");
    if(!el || _tipTarget === el) return;
    _tipTarget = el;
    tip.textContent = el.getAttribute("data-tip");
    tip.style.display = "block";
    positionTip(e);
  });
  document.body.addEventListener("mousemove", function(e){ if(_tipTarget) positionTip(e); });
  document.body.addEventListener("mouseout", function(e){
    var el = e.target.closest && e.target.closest("[data-tip]");
    if(el && el === _tipTarget){ _tipTarget = null; tip.style.display = "none"; }
  });
  function positionTip(e){
    var x = e.clientX || 20, y = e.clientY || 20, w = window.innerWidth;
    tip.style.left = Math.min(x + 12, w - 290) + "px";
    tip.style.top  = (y + 16) + "px";
  }
}
function escapeHtml(s){
  return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
}
function showMsg(id, text, kind){
  var el = $(id); if(!el) return;
  el.className = "msg show " + (kind||"ok");
  el.textContent = text;
}
function fmtDate(d){
  if(!d) return "—";

      for(var c2=0;c2<k;c2++){ var d2 = 0; for(var dim2=0;dim2<points[i2].length;dim2++) d2 += (points[i2][dim2]-centers[c2][dim2])*(points[i2][dim2]-centers[c2][dim2]); if(d2 < bestD){ bestD = d2; best = c2; } }

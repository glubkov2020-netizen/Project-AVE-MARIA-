function setupTerminal(){
  on($("termToggle"), "click", toggleTerminal);
  on($("termClose"), "click", function(){ $("terminal").classList.remove("open"); });
  qsa(".term-tabs button[data-tab]").forEach(function(b){
    on(b, "click", function(){
      var tab = b.getAttribute("data-tab");
      qsa(".term-tabs button[data-tab]").forEach(function(x){ x.classList.toggle("active", x===b); });
      qsa(".term-tab-panel").forEach(function(p){ p.classList.toggle("active", p.getAttribute("data-panel")===tab); });
      if(tab === "cmd") renderCommandCatalog();
      if(tab === "help") renderHelpPanel();
    });
  });
  qsa(".term-quick button").forEach(function(b){
    on(b, "click", function(){ runCommand(b.getAttribute("data-cmd")); });
  });
  var input = $("termInput"), hist = [], hIdx = -1;
  on(input, "keydown", function(e){
    if(e.key==="Enter"){
      var v = input.value.trim();
      if(v){ hist.push(v); hIdx = hist.length; runCommand(v); }
      input.value = "";
    } else if(e.key==="ArrowUp"){
      if(hIdx > 0){ hIdx--; input.value = hist[hIdx]||""; }
      e.preventDefault();
    } else if(e.key==="ArrowDown"){
      if(hIdx < hist.length-1){ hIdx++; input.value = hist[hIdx]||""; }
      else { hIdx = hist.length; input.value = ""; }
      e.preventDefault();
    } else if(e.key==="Tab"){
      e.preventDefault();
      var v = input.value;
      if(!v) return;
      var prefix = v.split(/\s+/)[0];
      var keys = Object.keys(COMMANDS);
      var match = keys.filter(function(k){ return k.indexOf(prefix)===0; })[0];
      if(match){ input.value = match + v.slice(prefix.length); }
    }
  });
  renderCommandCatalog();
  renderHelpPanel();
}


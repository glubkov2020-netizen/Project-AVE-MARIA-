function renderKpis(){
  var box = $("kpis"); if(!box) return;
  if(!state.data.length){
    box.innerHTML =
      '<div class="kpi"><div class="label">Строк</div><div class="val">0</div><div class="delta">добавьте данные</div></div>'+
      '<div class="kpi"><div class="label">Регионов</div><div class="val">0</div></div>'+
      '<div class="kpi"><div class="label">Годы</div><div class="val">—</div></div>'+
      '<div class="kpi"><div class="label">Сумма</div><div class="val">—</div></div>';
    return;
  }
  var years = yearsAll(), tot = totalsByYearSelected();
  var lastY = years[years.length-1], prevY = years[years.length-2];
  var lastV = tot[lastY]!=null?tot[lastY]:null;
  var prevV = prevY!==undefined?(tot[prevY]!=null?tot[prevY]:null):null;
  var yoy = (lastV!=null && prevV!=null && prevV>0) ? ((lastV-prevV)/prevV*100) : null;
  var totalSum = 0; for(var k in tot) totalSum += tot[k];
  var totVals = years.map(function(y){ return tot[y]||0; });
  var cagrTotal = cagrFromSeries(years, totVals);
  var hhi = null, shares = [];
  var sel = REGIONS.filter(function(r){return state.selected[r];});
  sel.forEach(function(r){ var v = valueAt(r,lastY); if(v!=null) shares.push(v); });
  if(shares.length){ var tt = sum(shares); if(tt>0){ var h=0; shares.forEach(function(v){ var s=v/tt*100; h+=s*s; }); hhi=h; } }
  var hhiInterp = hhi==null?"—":(hhi<1000?"низкая":hhi<1800?"умеренная":hhi<2500?"высокая":"очень высокая");
  var top = null;
  sel.forEach(function(r){ var v = valueAt(r,lastY); if(v!=null && (!top || v>top.value)) top={region:r,value:v}; });
  var yoyCls = yoy==null?"flat":(yoy>0?"up":(yoy<0?"down":"flat"));
  box.innerHTML =
    '<div class="kpi"><div class="label">Строк</div><div class="val">'+state.data.length+'</div><div class="delta">'+regionsWithData().length+' регионов</div></div>'+
    '<div class="kpi"><div class="label">Годы</div><div class="val">'+years[0]+'–'+lastY+'</div><div class="delta">'+years.length+' лет</div></div>'+
    '<div class="kpi"><div class="label">Сумма</div><div class="val">'+fmtNum(convertUnits(totalSum),1)+'<small>'+unitLabel()+'</small></div><div class="delta">'+sel.length+' регионов</div></div>'+
    '<div class="kpi"><div class="label">'+lastY+'</div><div class="val">'+(lastV!=null?fmtNum(convertUnits(lastV),1):"—")+'</div><div class="delta '+yoyCls+'">'+(yoy!=null?fmtNum(yoy,2)+"%":'—')+'</div></div>'+
    '<div class="kpi"><div class="label">CAGR</div><div class="val">'+(cagrTotal!=null?fmtNum(cagrTotal,2):"—")+'<small>%</small></div><div class="delta">за период</div></div>'+
    '<div class="kpi"><div class="label">HHI</div><div class="val">'+(hhi!=null?fmtNum(hhi,0):"—")+'</div><div class="delta">'+hhiInterp+'</div></div>'+
    '<div class="kpi"><div class="label">Лидер</div><div class="val" style="font-size:12px">'+(top?escapeHtml(top.region):"—")+'</div><div class="delta">'+(top?fmtNum(convertUnits(top.value),1):"—")+'</div></div>';
}

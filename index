  .msg.warn{background:var(--warn-soft); border:1px solid var(--warn); color:var(--warn)}

  .prompt-box{background:var(--accent-soft-2); border:1px dashed var(--border-strong); border-radius:var(--radius); padding:12px; margin-top:10px}
  .prompt-box pre{background:transparent; color:var(--text); margin:0; max-height:400px; overflow:auto; font-size:11px; padding:0}

  #chart, #trendChart, #structureChart, #compareChart, #maChart, #heatmapChart, #histChart, #waterfallChart, #boxChart, #radarChart, #pcaChart, #acfChart, #lagChart, #matrixChart, #passChart, #scenChart{width:100%; height:480px; min-height:300px}

  .figure-caption{text-align:center; font-size:12px; margin-top:8px; font-weight:500}
